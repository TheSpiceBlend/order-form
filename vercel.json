{
  "outputDirectory": "public",
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1.js" },
    { "src": "/login", "dest": "/login.html" },
    { "src": "/orders", "dest": "/orders.html" },
    { "src": "/print-stickers", "dest": "/print-stickers.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
